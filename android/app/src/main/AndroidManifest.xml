<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools">
<!-- package='com.rajofearth.synomilo'> -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
<uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <!--
      Required by the `phoneCall` foregroundServiceType override below.

      The manifest comment here claimed "@notifee/react-native itself declares
      MANAGE_OWN_CALLS and FOREGROUND_SERVICE_PHONE_CALL, which satisfies the
      Android 14 prerequisite". Checked against the merged release manifest:
      neither is present. Notifee contributes SCHEDULE_EXACT_ALARM and
      USE_FULL_SCREEN_INTENT, not the foreground-service pair. On Android 14+,
      starting a foreground service with a type the app holds no matching
      permission for throws SecurityException - which is why the ongoing-call
      notification could fail to appear at all rather than merely look wrong.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_PHONE_CALL"/>
    <uses-permission android:name="android.permission.MANAGE_OWN_CALLS"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <!--
      Full-screen intents are what turn a ringing notification into the ring
      screen on a locked device. On Android 14+ the permission alone is not enough:
      the user must also grant "Full screen notifications" special app access, or
      Android silently downgrades the notification to a heads-up and the full
      screen never appears. CallIntentModule exposes
      canRingOverLockScreen() / requestRingOverLockScreen() for exactly that.
    -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT"/>
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
      android:name="com.rajofearth.synomilo.MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:allowBackup="false"
      android:theme="@style/AppTheme"
      android:usesCleartextTraffic="${usesCleartextTraffic}"
      android:supportsRtl="true">
      <activity
        android:name="com.rajofearth.synomilo.MainActivity"
        tools:ignore="Instantiatable"
        android:label="@string/app_name"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|fontScale"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
      </activity>

      <!--
        The ringing screen.

        `fullScreenAction` / `pressAction` on the incoming-call notification point
        at this activity (src/notifications/callNotifications.ts). It is a plain
        Activity - not a ReactActivity - because it has to be able to draw
        Accept/Decline over the keyguard without booting the JS runtime, which is
        exactly what the previous target (MainActivity, which deliberately has no
        showWhenLocked/turnScreenOn) could not do.

        `android:screenOrientation` is pinned to portrait. An FSI launched while
        the device is mid-rotation used to land the ring screen in landscape, and
        a call UI that reshuffles itself as the phone turns is part of why this
        screen felt like a system dialog rather than like the app.

        exported="false": only this app may launch it (Notifee uses an explicit,
        same-UID intent). No LAUNCHER filter, so it cannot be started arbitrarily.
      -->
      <activity
        android:name="com.rajofearth.synomilo.IncomingCallActivity"
        android:theme="@style/Theme.CallRinging"
        android:launchMode="singleTop"
        android:showWhenLocked="true"
        android:turnScreenOn="true"
        android:screenOrientation="portrait"
        android:excludeFromRecents="true"
        android:taskAffinity="com.rajofearth.synomilo.call"
        android:noHistory="true"
        android:exported="false" />

      <!--
        EXACTLY ONE FirebaseMessagingService.

        Before this block the merged manifest declared three services bound to
        com.google.firebase.MESSAGING_EVENT:
          1. io.invertase.firebase.messaging.ReactNativeFirebaseMessagingService
             (from @react-native-firebase/messaging)  <- the one we keep
          2. com.google.firebase.messaging.FirebaseMessagingService
             (the Firebase SDK base class, android:priority="-500")

        Android binds MESSAGING_EVENT to exactly ONE service, so which one won was
        undefined - a message could land in a service that ignores it, which is the
        strongest Android-side explanation for "sometimes it rings, sometimes it
        doesn't". It also meant onNewToken could go to a service with no JS listener,
        silently killing push-token refresh.

        The third claimant that used to sit here (the push package's own FCM service) is gone with
        that package; the `tools:node="remove"` marker
        for it was dropped with the package, because a manifest merger rule naming a
        class that no longer exists is itself a build error under `tools:node="remove"`
        on a manifest that no longer declares it.
        (2) is removed because (1) is always present and always wins on priority;
        keeping the base-class fallback buys nothing but another claimant.
        Direct-boot (pre-unlock) push reception is the one capability lost, and it
        is irrelevant for a call UI that needs the keyguard anyway.
      -->
      <service
        android:name="com.google.firebase.messaging.FirebaseMessagingService"
        tools:node="remove" />

      <!--
        Notifee ships its foreground service as foregroundServiceType="shortService",
        which Android 14+ kills after 3 minutes - useless for a call. Override it to
        phoneCall. FOREGROUND_SERVICE_PHONE_CALL and MANAGE_OWN_CALLS are declared at
        the top of this file; they used to be assumed to arrive from
        @notifee/react-native, which does not do that, and on Android 14+ starting
        a phoneCall-typed foreground service without them throws SecurityException.
      -->
      <service
        android:name="app.notifee.core.ForegroundService"
        android:foregroundServiceType="phoneCall"
        tools:replace="android:foregroundServiceType" />

      <meta-data
        android:name="com.google.firebase.messaging.default_notification_channel_id"
        android:value="default"
        tools:replace="android:value" />
      <meta-data
        android:name="com.google.firebase.messaging.default_notification_icon"
        android:resource="@drawable/ic_stat_message"
        tools:replace="android:resource" />

      <provider
        android:name="androidx.core.content.FileProvider"
        android:authorities="${applicationId}.fileprovider"
        android:exported="false"
        android:grantUriPermissions="true">
        <meta-data
          android:name="android.support.FILE_PROVIDER_PATHS"
          android:resource="@xml/file_paths"
          tools:replace="android:resource" />
      </provider>

    </application>
</manifest>
