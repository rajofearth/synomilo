<?xml version="1.0" encoding="utf-8"?>
<!--
  The app's monochrome palette, mirrored from src/theme/paperTheme.ts so that
  IncomingCallActivity - which is a plain Activity and cannot reach the Paper
  theme - draws in the same blacks and greys as every screen inside the app.

  Strictly achromatic: every value below satisfies R == G == B. Do not introduce
  hue here. Values are the dark-scheme entries, which is the only scheme a
  lock-screen ring window can use without becoming unreadable over a wallpaper.
-->
<resources>
    <color name="call_background">#0B0B0B</color>
    <color name="call_surface">#131313</color>
    <color name="call_surface_variant">#1F1F1F</color>
    <color name="call_on_surface">#F2F2F2</color>
    <color name="call_on_surface_variant">#A0A0A0</color>
    <color name="call_outline">#6B6B6B</color>
    <color name="call_outline_variant">#2E2E2E</color>
    <color name="call_primary">#EDEDED</color>
    <color name="call_on_primary">#0B0B0B</color>
    <color name="call_primary_container">#3A3A3A</color>
    <color name="call_on_primary_container">#FFFFFF</color>
</resources>